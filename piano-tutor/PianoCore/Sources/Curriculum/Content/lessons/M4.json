                "quality": "major",
                "inversion": 0
              },
              {
                "root": "C",
                "quality": "major",
                "inversion": 0
              },
              {
                "root": "D",
                "quality": "major",
                "inversion": 0
              },
              {
                "root": "G",
                "quality": "major",
                "inversion": 0
              }
            ],
            "labels": [
              "I",
              "IV",
              "V",
              "I"
            ]
          }
        },
        {
          "type": "text",
          "text": "A second pattern, I–V–vi–IV, is behind a great many popular songs."
        },
        {
          "type": "exercise",
          "exercise": {
